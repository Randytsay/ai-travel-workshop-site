---
import { navItems } from '../../content/navigation';
import ProgressTracker from '../progress/ProgressTracker.astro';
const { currentPath } = Astro.props;
---
<aside class="sidebar">
  <div class="sidebar-brand">
    <span class="brand-mark" aria-hidden="true">AI</span>
    <div>
      <h3>AI 旅遊規劃師</h3>
      <p>Workshop Route</p>
    </div>
  </div>
  
  <ProgressTracker />

  <div class="nav-route">
    {navItems.map((item, index) => (
      <a class={`nav-link ${currentPath === item.path ? 'active' : ''}`} href={item.path}>
        <span class="nav-step">{String(index + 1).padStart(2, '0')}</span>
        <span>{item.label}</span>
      </a>
    ))}
  </div>
  <div class="nav-meta">
    <strong>現場模式</strong>
    <p class="nav-meta-block">依序完成即夢短影音、公仔、旅遊需求、NotebookLM 研究與貼圖素材。</p>
  </div>
</aside>
