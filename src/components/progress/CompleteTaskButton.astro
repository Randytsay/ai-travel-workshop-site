---
const { taskId, buttonLabel = '我已完成這項任務', nextLabel, nextHref, successMessage = '太棒了！這項任務已完成。' } = Astro.props;
---
<div class="task-completion-zone passport-stamp-wrap" data-task-id={taskId}>
  <div class="passport-stamp" data-passport-stamp>PASSPORT COMPLETED</div>
  <div class="task-status-initial">
    <p class="task-kicker">完成這一站後再前進</p>
    <button class="btn complete-task-btn" type="button">
      {buttonLabel}
    </button>
  </div>
  <div class="task-status-complete" hidden>
    <div class="notice" style="margin-bottom:12px;">
      <p><strong>✨ {successMessage}</strong></p>
      {nextLabel && nextHref && <p>接下來：<a href={nextHref} class="link-next">{nextLabel} →</a></p>}
    </div>
    {nextLabel && nextHref && (
      <a href={nextHref} class="btn alt">
        前往下一關：{nextLabel}
      </a>
    )}
  </div>
</div>

<style>
  .task-completion-zone {
    margin: 24px 0;
    padding: 26px;
    background: linear-gradient(135deg, #fff, #f7fcff);
    border: 1px solid var(--page-accent-glow, rgba(53,183,212,0.22));
    border-radius: 16px;
    text-align: center;
    box-shadow: var(--shadow-card);
    position: relative;
    overflow: visible;
  }
  .task-kicker {
    margin: 0 0 12px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .complete-task-btn {
    min-width: 200px;
  }
  .link-next {
    color: var(--page-accent, var(--coral));
    font-weight: 700;
    text-decoration: underline;
  }
  .task-status-complete .notice {
    text-align: left;
    background: linear-gradient(145deg, #f0f9ff, #ffffff);
    border-left: 4px solid var(--page-accent, var(--sky));
    border-radius: 12px;
    padding: 14px 16px;
  }
</style>

<script>
  import { markTaskComplete, isTaskComplete } from '../../utils/progressStore';

  const initCompleteTaskButtons = () => {
    document.querySelectorAll('.task-completion-zone').forEach((z) => {
      const zone = z as HTMLElement;
      if (zone.dataset.hasListener) return;
      zone.dataset.hasListener = 'true';

      const taskId = zone.getAttribute('data-task-id');
      const initial = zone.querySelector('.task-status-initial');
      const complete = zone.querySelector('.task-status-complete');
      const btn = zone.querySelector('.complete-task-btn');
      const stamp = zone.querySelector('[data-passport-stamp]') as HTMLElement | null;

      const setCompleted = (animate = false) => {
        initial?.setAttribute('hidden', 'true');
        complete?.removeAttribute('hidden');
        zone.style.borderStyle = 'solid';
        zone.style.borderColor = 'var(--page-accent)';
        zone.style.background = 'rgba(255, 255, 255, 0.9)';
        
        if (stamp) {
          if (animate) {
            stamp.classList.add('passport-stamp-active');
          } else {
            stamp.style.opacity = '0.82';
            stamp.style.transform = 'rotate(-14deg) scale(1)';
          }
        }
      };

      const setIncomplete = () => {
        initial?.removeAttribute('hidden');
        complete?.setAttribute('hidden', 'true');
        zone.style.borderStyle = '';
        zone.style.borderColor = '';
        zone.style.background = '';
        if (stamp) {
          stamp.classList.remove('passport-stamp-active');
          stamp.style.opacity = '';
          stamp.style.transform = '';
        }
      };

      if (taskId && isTaskComplete(taskId)) {
        setCompleted(false);
      }

      btn?.addEventListener('click', () => {
        if (taskId) {
          markTaskComplete(taskId);
          setCompleted(true);
          window.dispatchEvent(new CustomEvent('task-completed-ui', { detail: { taskId } }));
        }
      });

      const handleReset = () => {
        setIncomplete();
      };
      
      window.addEventListener('progress-reset', handleReset);
      
      document.addEventListener('astro:before-swap', () => {
        window.removeEventListener('progress-reset', handleReset);
      }, { once: true });
    });
  };

  document.addEventListener('astro:page-load', initCompleteTaskButtons);
</script>
