---
import { progressTasks } from '../../content/progressTasks';
const total = progressTasks.length;
---
<div class="progress-tracker" data-progress-tracker>
  <div class="progress-head">
    <span>旅程進度</span>
    <strong data-progress-percent>0%</strong>
  </div>
  <div class="progress-bar-bg">
    <div class="progress-bar-fill" data-progress-fill style="width: 0%"></div>
  </div>
  <p class="progress-text" data-progress-text-container>
    <span class="progress-count" data-progress-count>0</span> / <span>{total}</span> 已完成
  </p>
  <p class="progress-next" data-progress-next></p>
  <p class="progress-celebration" data-progress-celebration hidden>太棒了，今天的工作坊任務全完成！</p>
  <button class="progress-reset-btn" type="button" data-progress-reset>重新開始</button>
</div>

<style>
  .progress-tracker {
    padding: 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    margin-bottom: 12px;
    box-shadow: var(--shadow-soft);
  }
  .progress-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--night);
    font-size: 0.86rem;
    font-weight: 900;
  }
  .progress-head strong {
    color: var(--coral);
  }
  .progress-bar-bg {
    height: 10px;
    background: #f0f4f8;
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 6px;
  }
  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--sky), var(--teal));
    transition: width 0.4s ease-out;
  }
  .progress-text {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
    text-align: left;
  }
  .progress-count {
    color: var(--coral);
  }
  .progress-next {
    margin: 6px 0 0;
    color: var(--night);
    font-size: 0.8rem;
    font-weight: 850;
  }
  .progress-celebration {
    margin: 6px 0 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--teal);
    text-align: center;
    animation: fadeIn 0.5s ease-out;
  }
  .progress-reset-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    padding: 5px 9px;
    border: 1px solid rgba(104, 121, 138, 0.24);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }
  .progress-reset-btn:hover {
    border-color: rgba(255, 111, 97, 0.45);
    background: rgba(255, 111, 97, 0.08);
    color: var(--coral);
  }
  .progress-reset-btn:focus-visible {
    outline: 3px solid rgba(53, 183, 212, 0.26);
    outline-offset: 2px;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { getProgress, resetProgress } from '../../utils/progressStore';
  import { progressTasks } from '../../content/progressTasks';

  const updateUI = () => {
    const progress = getProgress();
    const count = progress.length;
    const total = progressTasks.length;
    const percentage = (count / total) * 100;

    document.querySelectorAll('[data-progress-tracker]').forEach((tracker) => {
      const container = tracker as HTMLElement;
      const fill = container.querySelector('[data-progress-fill]') as HTMLElement | null;
      const countText = container.querySelector('[data-progress-count]') as HTMLElement | null;
      const percentText = container.querySelector('[data-progress-percent]') as HTMLElement | null;
      const textContainer = container.querySelector('[data-progress-text-container]') as HTMLElement | null;
      const nextText = container.querySelector('[data-progress-next]') as HTMLElement | null;
      const celebration = container.querySelector('[data-progress-celebration]') as HTMLElement | null;
      const nextTask = progressTasks.find((task) => !progress.includes(task.id));

      if (fill) fill.style.width = `${percentage}%`;
      if (countText) countText.textContent = String(count);
      if (percentText) percentText.textContent = `${Math.round(percentage)}%`;
      if (nextText) nextText.textContent = nextTask ? `下一站：${nextTask.label}` : '';

      if (count === total && total > 0) {
        if (textContainer) textContainer.hidden = true;
        if (nextText) nextText.hidden = true;
        if (celebration) celebration.hidden = false;
      } else {
        if (textContainer) textContainer.hidden = false;
        if (nextText) nextText.hidden = false;
        if (celebration) celebration.hidden = true;
      }
    });
  };

  // Initial update
  updateUI();

  document.querySelectorAll('[data-progress-reset]').forEach((button) => {
    button.addEventListener('click', () => resetProgress());
  });

  // Listen for updates
  window.addEventListener('progress-update', updateUI);
</script>
