---
import PromptCard from './PromptCard.astro';
const { title, description, prompts, defaultOpen = false } = Astro.props;
---
<section class="prompt-group">
  <div class="section-heading compact">
    <p class="eyebrow">提示詞</p>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  <div class="prompt-grid single-prompt" style="grid-template-columns: 1fr;">
    <PromptCard title={title} prompt={prompts.chatgpt} defaultOpen={defaultOpen} />
  </div>
</section>
