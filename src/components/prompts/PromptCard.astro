---
import Icon from '../common/Icon.astro';
const { title, platform, prompt, defaultOpen = false } = Astro.props;
---
<details class="prompt-card card" open={defaultOpen}>
  <summary>
    <span>
      <strong>{title}</strong>
      {platform && <small>{platform}</small>}
    </span>
    <span class="summary-hint">查看提示詞</span>
  </summary>
  <pre>{prompt}</pre>
  <div class="prompt-actions-row">
    <button class="btn copy-btn" type="button" data-text={prompt}>
      <Icon name="sparkles" size={14} style="margin-right: 6px; pointer-events: none;" />
      <span class="btn-text">一鍵複製</span>
    </button>
    <div class="ai-launch-buttons">
      <a class="btn alt chatgpt-btn-round" href="https://chatgpt.com/" target="_blank" rel="noopener noreferrer" title="開啟 ChatGPT">
        <svg class="ai-logo" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20.73 11.23a4.42 4.42 0 0 0-.8-2.92 4.46 4.46 0 0 0-2.45-1.63 4.41 4.41 0 0 0-3.32-.2 4.46 4.46 0 0 0-2.61-2.18 4.43 4.43 0 0 0-3.36.1 4.46 4.46 0 0 0-2.44 2.13 4.42 4.42 0 0 0-1.74 2.5 4.46 4.46 0 0 0 .15 3.36 4.42 4.42 0 0 0 .8 2.92 4.46 4.46 0 0 0 2.45 1.63 4.41 4.41 0 0 0 3.32.2A4.46 4.46 0 0 0 13.5 19.3a4.43 4.43 0 0 0 3.36-.1 4.46 4.46 0 0 0 2.44-2.13 4.42 4.42 0 0 0 1.74-2.5 4.46 4.46 0 0 0-.31-3.34zm-8.85 5.86a2.82 2.82 0 0 1-1.37-.36l.07-.04 2.87-1.66a.79.79 0 0 0 .4-.68v-4.06l1.2-.69a.05.05 0 0 1 .05 0l3.52 2.03a2.83 2.83 0 0 1-1.28 4.31 2.81 2.81 0 0 1-2.2-.18l-3.26-1.88zm-5.18-2.64a2.83 2.83 0 0 1-.36-2.5 2.81 2.81 0 0 1 1.48-1.75l3.23-1.87v3.74a.79.79 0 0 0 .4.68l3.52 2.03v1.38a.05.05 0 0 1-.03.04l-3.52 2.03a2.83 2.83 0 0 1-4.72-2.15l-.02-1.64zm1.96-5.83a2.82 2.82 0 0 1 2.19-.18l-.07.04-2.87 1.66a.79.79 0 0 0-.4.68v4.06l-1.2.69a.05.05 0 0 1-.05 0l-3.52-2.03a2.83 2.83 0 0 1 1.28-4.31 2.81 2.81 0 0 1 2.2.18l3.26 1.88zm8.07 1.41l-3.23 1.87v-3.74a.79.79 0 0 0-.4-.68l-3.52-2.03v-1.38a.05.05 0 0 1 .03-.04l3.52-2.03a2.83 2.83 0 0 1 4.72 2.15l.02 1.64a2.83 2.83 0 0 1 .86 4.25z"/></svg>
      </a>
      <a class="btn alt gemini-btn-round" href="https://gemini.google.com/" target="_blank" rel="noopener noreferrer" title="開啟 Gemini">
        <svg class="ai-logo" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 2c-.3 0-.6.1-.8.4l-3 6.1-6.1 3c-.4.2-.6.6-.6.9s.2.7.6.9l6.1 3 3 6.1c.2.4.5.6.8.6s.6-.2.8-.6l3-6.1 6.1-3c.4-.2.6-.6.6-.9s-.2-.7-.6-.9l-.1-.1-6-3-3-6.1c-.2-.3-.5-.4-.8-.4z" fill="url(#gemini-gradient-card-v3)"/>
          <defs>
            <linearGradient id="gemini-gradient-card-v3" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#1a73e8" />
              <stop offset="100%" stop-color="#8ab4f8" />
            </linearGradient>
          </defs>
        </svg>
      </a>
    </div>
  </div>
</details>

<style>
  .prompt-actions-row {
    margin-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .copy-btn {
    min-height: 40px !important;
    padding: 8px 16px !important;
    font-size: 0.88rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .ai-launch-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .chatgpt-btn-round {
    background: #0f0f10 !important;
    color: #10a37f !important;
    border: 1px solid rgba(16, 163, 127, 0.4) !important;
    width: 44px !important;
    height: 44px !important;
    padding: 0 !important;
    border-radius: 50% !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .chatgpt-btn-round:hover {
    background: #1a1a1c !important;
    border-color: #10a37f !important;
    transform: scale(1.05);
  }
  .gemini-btn-round {
    background: #f0f4f9 !important;
    color: #1a73e8 !important;
    border: 1px solid rgba(26, 115, 232, 0.3) !important;
    width: 44px !important;
    height: 44px !important;
    padding: 0 !important;
    border-radius: 50% !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .gemini-btn-round:hover {
    background: #e3ecf5 !important;
    border-color: #1a73e8 !important;
    transform: scale(1.05);
  }
  .ai-logo {
    flex-shrink: 0;
  }
  .btn-text {
    pointer-events: none;
  }
  @media (max-width: 576px) {
    .prompt-actions-row {
      flex-direction: column;
      align-items: stretch;
    }
    .ai-launch-buttons {
      width: 100%;
      justify-content: flex-end;
    }
    .copy-btn {
      width: 100%;
    }
  }
</style>
