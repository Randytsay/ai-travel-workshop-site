---
import WorkshopLayout from '../layouts/WorkshopLayout.astro';
import CompleteTaskButton from '../components/progress/CompleteTaskButton.astro';
import StationRole from '../components/common/StationRole.astro';
import Icon from '../components/common/Icon.astro';
import { stationRoles } from '../content/journeyGuide';
---
<WorkshopLayout title="認識 AI 與旅遊人格測驗" currentPath="/doll-maker">
  <section class="hero">
    <div class="hero-home">
      <div>
        <p class="eyebrow">✨ 第一步：靈感發想</p>
        <h1>探索你的旅遊人格與 AI 靈感</h1>
        <p>在開始規劃行程前，讓我們先熟悉 AI 操作介面，並完成簡單的人格測驗，獲取您專屬的 AI 頭像生圖指令！</p>
        <div class="actions">
          <a class="btn" href="#quiz-section">開始性格測驗</a>
          <a class="btn alt" href="#ai-intro">認識 AI 助手</a>
        </div>
      </div>
      <div class="hero-media">
        <img src="/images/doll-maker/hero-before-after-01.webp" alt="旅遊人格測驗 Hero 示意圖" loading="eager" decoding="async" style="border-radius: var(--radius-md); box-shadow: var(--shadow-medium);" />
      </div>
    </div>
  </section>

  <StationRole role={stationRoles['/doll-maker']} />

  <!-- Step 1: AI Interface Intro -->
  <section class="section-heading" id="ai-intro">
    <p class="eyebrow">📱 Step 1: 認識你的 AI 助手</p>
    <h2>像用 LINE 聊天一樣簡單！</h2>
  </section>
  
  <div class="card ai-intro-card">
    <div class="ai-intro-content">
      <div class="ai-intro-media">
        <div class="ai-intro-images">
          <div class="ai-intro-img-box">
            <span class="ai-intro-img-label">💻 電腦網頁版</span>
            <img src="/images/doll-maker/ai-interface-intro.png" alt="AI 電腦網頁版操作介面" class="step-real-image zoomable-interface-img" />
          </div>
          <div class="ai-intro-img-box">
            <span class="ai-intro-img-label">📱 手機 App 版</span>
            <img src="/images/doll-maker/mobile-interface.jpg" alt="AI 手機 App 版操作介面" class="step-real-image zoomable-interface-img" />
          </div>
        </div>
        <small class="qr-tip" style="margin-top: 12px; display: block;">💡 點擊圖片可放大觀看詳細介面</small>
      </div>
      <div class="ai-intro-text">
        <p class="intro-desc">在開始規劃前，讓我們先來熟悉一下 AI 的操作介面。對照左圖，操作步驟如下：</p>
        <ul class="intro-steps">
          <li>
            <div class="step-badge">1</div>
            <div>
              <strong>🆕 建立新對話 (New Chat)</strong>
              <p>點擊左上角的「新對話」按鈕，開啟一個乾淨空白的對話，開始你的旅行靈感探索。</p>
            </div>
          </li>
          <li>
            <div class="step-badge">2</div>
            <div>
              <strong>➕ 按 "+" 號</strong>
              <p>點擊輸入框左側的「+」號按鈕，展開附加功能選單。</p>
            </div>
          </li>
          <li>
            <div class="step-badge">3</div>
            <div>
              <strong>📎 新增照片和檔案</strong>
              <p>點選選單中的「新增照片和檔案」，將您的清楚人臉個人照上傳給 AI 讀取。</p>
            </div>
          </li>
          <li>
            <div class="step-badge">4</div>
            <div>
              <strong>✍️ 提示詞輸入區貼上指令</strong>
              <p>在「想問什麼都可以」的輸入區貼上您複製的人格生圖指令，點擊右側送出按鈕即可開始生成！</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Step 2: Personality Quiz -->
  <section class="section-heading" id="quiz-section" style="margin-top: 56px;">
    <p class="eyebrow">🔮 Step 2: 破冰初體驗</p>
    <h2>專屬旅遊人格測驗與 AI 生圖</h2>
  </section>

  <section class="card quiz-card">
    <div class="quiz-body">
      <p class="quiz-subtitle">完成下方簡單的測驗，我們將為您生成專屬的 AI 生圖提示詞，讓您可以到 ChatGPT 畫出自己的旅遊角色！</p>
      
      <form id="quiz-form">
        <div class="form-group mb-6">
          <label class="form-label">您的名字 / 暱稱 <span class="required-tag">(必填)</span></label>
          <input type="text" id="quiz-name" name="quiz-name" required class="form-input" placeholder="例如：Randy" />
        </div>

        <!-- Q1 -->
        <div class="form-group mb-8">
          <label class="form-label">1. ✈️ 你最嚮往哪種旅行基調？</label>
          <div class="options-grid">
            <label class="option-item">
              <input type="radio" name="q1" value="A" required />
              <div class="option-content">
                <strong>🌿 悠閒慢活</strong>
                <span>不趕行程，在咖啡廳坐一下午也無所謂</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q1" value="B" required />
              <div class="option-content">
                <strong>🏃 有效率打卡</strong>
                <span>精準掌握時間，要把必去景點都集滿</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q1" value="C" required />
              <div class="option-content">
                <strong>🏺 深度文化</strong>
                <span>走進歷史巷弄，聽當地的故事</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q1" value="D" required />
              <div class="option-content">
                <strong>⚡ 極限挑戰</strong>
                <span>上山下海，體驗平時不敢做的事</span>
              </div>
            </label>
          </div>
        </div>

        <hr class="quiz-divider" />

        <!-- Q2 -->
        <div class="form-group mb-8">
          <label class="form-label">2. 😅 店家沒開、行程突發狀況，你通常怎麼做？</label>
          <div class="options-grid">
            <label class="option-item">
              <input type="radio" name="q2" value="A" required />
              <div class="option-content">
                <strong>📱 立刻搜尋替代方案</strong>
                <span>打開 AI 或地圖找周邊最高評分的地方</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q2" value="B" required />
              <div class="option-content">
                <strong>🦋 隨便逛逛看看</strong>
                <span>附近走走說不定反而有驚喜</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q2" value="C" required />
              <div class="option-content">
                <strong>☕ 先找咖啡廳坐下</strong>
                <span>沉澱一下，再慢慢想下一步去哪</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q2" value="D" required />
              <div class="option-content">
                <strong>📋 執行備用計畫</strong>
                <span>早就準備好 Plan B，直接切換</span>
              </div>
            </label>
          </div>
        </div>

        <hr class="quiz-divider" />

        <!-- Q3 -->
        <div class="form-group mb-8">
          <label class="form-label">3. 🗓️ 你喜歡怎樣安排一天的行程密集度？</label>
          <div class="options-grid">
            <label class="option-item">
              <input type="radio" name="q3" value="A" required />
              <div class="option-content">
                <strong>🌅 佛系節奏</strong>
                <span>一天 1-2 個大點就好，其他隨緣</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q3" value="B" required />
              <div class="option-content">
                <strong>🚀 特種兵模式</strong>
                <span>從早到晚行程填滿滿，體力不是問題</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q3" value="C" required />
              <div class="option-content">
                <strong>⚖️ 半糖主義</strong>
                <span>早上跑行程，下午留白放空</span>
              </div>
            </label>
            <label class="option-item">
              <input type="radio" name="q3" value="D" required />
              <div class="option-content">
                <strong>📐 精準串聯</strong>
                <span>依交通動線安排 3-4 個必去地點</span>
              </div>
            </label>
          </div>
        </div>
      </form>

      <!-- Quiz Result (Hidden by default) -->
      <div id="quiz-result" class="result-box" style="display: none;">
        <div class="result-header">
          <span class="sparkle-icon">✨</span>
          <h4>您的旅行人格分析報告</h4>
        </div>
        <div class="result-title" id="result-fullname"></div>
        <p id="result-desc" class="result-description"></p>
        
        <div class="prompt-section">
          <div class="prompt-header">
            <strong>🎨 專屬生圖指令</strong>
            <span>可複製下方指令貼給 AI 繪圖工具</span>
          </div>
          <textarea id="result-prompt" class="prompt-textarea" readonly></textarea>
          
          <div class="prompt-actions-row">
            <button type="button" id="copy-prompt-btn" class="btn copy-btn">
              <Icon name="sparkles" size={14} style="margin-right: 6px; pointer-events: none;" />
              <span class="btn-text">📋 複製生圖指令</span>
            </button>
            <div class="ai-launch-buttons">
              <a href="https://chatgpt.com/" target="_blank" rel="noopener noreferrer" class="btn ai-btn chatgpt-btn-brand">
                <svg class="ai-logo" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.73 11.23a4.42 4.42 0 0 0-.8-2.92 4.46 4.46 0 0 0-2.45-1.63 4.41 4.41 0 0 0-3.32-.2 4.46 4.46 0 0 0-2.61-2.18 4.43 4.43 0 0 0-3.36.1 4.46 4.46 0 0 0-2.44 2.13 4.42 4.42 0 0 0-1.74 2.5 4.46 4.46 0 0 0 .15 3.36 4.42 4.42 0 0 0 .8 2.92 4.46 4.46 0 0 0 2.45 1.63 4.41 4.41 0 0 0 3.32.2A4.46 4.46 0 0 0 13.5 19.3a4.43 4.43 0 0 0 3.36-.1 4.46 4.46 0 0 0 2.44-2.13 4.42 4.42 0 0 0 1.74-2.5 4.46 4.46 0 0 0-.31-3.34zm-8.85 5.86a2.82 2.82 0 0 1-1.37-.36l.07-.04 2.87-1.66a.79.79 0 0 0 .4-.68v-4.06l1.2-.69a.05.05 0 0 1 .05 0l3.52 2.03a2.83 2.83 0 0 1-1.28 4.31 2.81 2.81 0 0 1-2.2-.18l-3.26-1.88zm-5.18-2.64a2.83 2.83 0 0 1-.36-2.5 2.81 2.81 0 0 1 1.48-1.75l3.23-1.87v3.74a.79.79 0 0 0 .4.68l3.52 2.03v1.38a.05.05 0 0 1-.03.04l-3.52 2.03a2.83 2.83 0 0 1-4.72-2.15l-.02-1.64zm1.96-5.83a2.82 2.82 0 0 1 2.19-.18l-.07.04-2.87 1.66a.79.79 0 0 0-.4.68v-4.06l-1.2.69a.05.05 0 0 1-.05 0l-3.52-2.03a2.83 2.83 0 0 1 1.28-4.31 2.81 2.81 0 0 1 2.2.18l3.26 1.88zm8.07 1.41l-3.23 1.87v-3.74a.79.79 0 0 0-.4-.68l-3.52-2.03v-1.38a.05.05 0 0 1 .03-.04l3.52-2.03a2.83 2.83 0 0 1 4.72 2.15l.02 1.64a2.83 2.83 0 0 1 .86 4.25z"/></svg>
                <span>開啟 ChatGPT</span>
              </a>
              <a href="https://gemini.google.com/" target="_blank" rel="noopener noreferrer" class="btn ai-btn gemini-btn-brand">
                <svg class="ai-logo" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M12 2c-.3 0-.6.1-.8.4l-3 6.1-6.1 3c-.4.2-.6.6-.6.9s.2.7.6.9l6.1 3 3 6.1c.2.4.5.6.8.6s.6-.2.8-.6l3-6.1 6.1-3c.4-.2.6-.6.6-.9s-.2-.7-.6-.9l-.1-.1-6-3-3-6.1c-.2-.3-.5-.4-.8-.4z"/>
                </svg>
                <span>開啟 Gemini</span>
              </a>
            </div>

        </div>
      </div>
    </div>
  </section>

  <CompleteTaskButton 
    taskId="doll-maker-complete" 
    buttonLabel="我已完成旅遊人格測驗"
    nextLabel="旅遊需求整理" 
    nextHref="/travel-planner"
    successMessage="太棒了！您已成功認識 AI 並獲得專屬旅遊人格，接下來我們將開始整理旅遊需求！"
  />

  <script is:inline>
    // ===== 旅遊人格測驗邏輯 =====
    const BASE = {
      A: { 
        emoji: '🌿', 
        name: '慢活旅行者', 
        cartoonStyle: '可愛皮克斯 3D 渲染風格 (Pixar style 3D render)，場景：淺草寺馬卡龍色系，溫暖柔和光影，精緻質感，豐富細節', 
        personality: '您是一個懂得在忙碌世界中尋找寧靜的人。對您而言，旅行不是為了抵達目的地，而是享受過程中的每一刻呼吸。您喜歡在陌生的城市尋找一家有質感的咖啡廳，坐下來觀察路人，或是讀一本想看很久的書。您對細節有著敏銳的觀察力，牆角的青苔或午後的陽光都能讓您感動。這種「慢」並非懶散，而是一種對生命品質的堅持，讓您在旅途中獲得真正的療癒與能量。您更傾向於深入感受一個地方的靈魂，而非僅僅在著名標誌前打卡。' 
      },
      B: { 
        emoji: '🏃', 
        name: '極速旅人', 
        cartoonStyle: '可愛潮流 3D 渲染風格，場景：澀谷霓虹夜景，繽紛色彩，精緻細節，高品質光影，賽博龐克可愛化', 
        personality: '您是效率與行動力的化身，時間對您來說是最珍貴的資源。您熱愛達成目標的成就感，看到行程表上的景點一個個被勾選，會讓您感到無比滿足。您的精力旺盛，總能在最短的時間內體驗最精采的活動。您擅長利用各種科技工具來優化路徑，不喜歡任何形式的拖延或浪費。朋友都非常依賴您的策劃與執行能力，因為跟著您走，絕對能玩得最充實、最精彩，在有限的假期間創造出最大化的回憶價值。' 
      },
      C: { 
        emoji: '🏺', 
        name: '文化沉澱者', 
        cartoonStyle: '精緻手繪插畫風格 (Exquisite Hand-drawn Illustration)，場景：京都金閣寺，優雅溫潤色彩，富有層次感，高品質質感，文藝氣息', 
        personality: '您擁有一顆充滿同理心與好奇心的靈魂，旅行對您來說是一場與土地的靈魂對話。您並不滿足於走馬看花的觀光，而是渴望深入了解當地的歷史、傳統與生活方式。您喜歡逛當地的傳統市場，與小販聊天，或是參與在地的節慶活動。您相信每座城市都有自己的心跳與脈絡，而您的使命就是去傾聽並理解它。您帶回家的不只是照片，更是滿滿的感動與深刻的哲學思考，這種深度的連結讓您的視野變得更寬廣。' 
      },
      D: { 
        emoji: '⚡', 
        name: '冒險先驅', 
        cartoonStyle: '可愛冒險 3D 風格，場景：富士山日出雲海，精緻戶外裝備細節，壯麗柔和光影，電影級畫面質感', 
        personality: '「挑戰」是您的生命密碼，您拒絕平庸與安逸的生活方式。旅行是您探索世界邊界的一種途徑，越是未知的領域越能激發您的鬥志與生命力。您熱愛體能上的挑戰，無論是攀登陡峭的高山還是潛入神秘的深海，都能讓您感受到生命的真實跳動與脈搏。您不怕困難，反而視挑戰為成長的養分。您有一種天生的領導氣質與勇氣，總能鼓勵身邊的人踏出舒適圈，去發現那個更強大的自己。' 
      }
    };
    
    const MOD = {
      AA: { suffix: '·科技適應型', modPersonality: '再加上您對科技的高度敏感度，您是那種會用 AI 把旅程優化到極致的人。手機是您最強的數位旅伴，比起傳統地圖，您更信任數據與即時資訊。您懂得如何利用數位工具避開人群、尋找最高評分的店家，這種智能化的旅行方式，讓您的每一步都走得精準且優雅。' },
      AB: { suffix: '·隨遇而安型', modPersonality: '突發狀況對您來說從來不是困擾，反而是驚喜冒險的開端。您擁有一種神奇的心理韌性，總能在計畫外的轉彎處，找到最動人的風景。您不拘泥於刻板的行程，這種靈活的生命態度，讓您的旅行充滿了詩意與未知的喜悅。' },
      AC: { suffix: '·從容探索型', modPersonality: '遇到環境的變化，您總是保持著不慌不忙的優雅。您會先找一間安靜的咖啡廳坐下來，讓思緒在香氣中沉澱，等內心平靜後再決定下一步。這份難得的從容感，讓您的旅行永遠比別人多了一份深度與美學品味，這也是您獨特的魅力所在。' },
      AD: { suffix: '·嚴謹慢活型', modPersonality: '您的行囊裡永遠備有 Plan B 甚至 Plan C，因為您相信充分的準備是享受自由的前提。這份嚴謹與細心，讓您的旅程幾乎不會出現令人尷尬的差錯。朋友們都說跟您一起出遊是最放心的，因為您總是能把細節掌控得恰到好處，讓慢活也能過得很精緻。' },
      BA: { suffix: '·打卡爆肝型', modPersonality: '您的社交媒體限時動態，永遠是朋友圈裡最令人羨慕的焦點。您擅長捕捉最完美的角度，並利用最新科技提升打卡效率。對您來說，分享美的事物是一種生活態度，您那敏銳的視覺直覺，讓每張照片都像是精心設計的藝術品。' },
      BB: { suffix: '·狂野隨興型', modPersonality: '您是旅行界真正的自由靈魂，對您來說「沒有計畫」就是最好的計畫。您熱愛那種臨時起意、說走就走的快感。在陌生的十字路口隨性轉個彎，往往就能開啟一段意想不到的精彩故事。這種狂野的生命力，讓您每次旅行都像是一場未知的慶典。' },
      BC: { suffix: '·率真漫遊型', modPersonality: '您不需要冷冰冰的星星指南，路邊阿伯熱情推薦的小攤位才是您的真愛。您擁有一份純粹的率真，總能用最直接的方式與在地人連結。這種接地氣的旅行風格，讓您總能品嚐到最有溫度、最道地的生活滋味，這也是最讓您感到充實的時刻。' },
      BD: { suffix: '·精算達人型', modPersonality: '您擁有一雙能瞬間看穿「價值」的利眼。在同樣的預算下，您總能策劃出比別人精彩三倍的體驗，這不僅是省錢，更是一種聰明生活的智慧。您懂得把資源花在刀口上，這種精算的能力讓您的每趟旅程都顯得無比聰明且充滿成就感。' },
