---
import WorkshopLayout from '../layouts/WorkshopLayout.astro';
import ImageCard from '../components/common/ImageCard.astro';
import Icon from '../components/common/Icon.astro';
import { Image } from 'astro:assets';
import heroMain from '../assets/hero-main.png';
import { schedule } from '../content/schedule';
import { homeAudience, homeInteractions, homeOutcomes } from '../content/workshopPages';
import { navItems } from '../content/navigation';
import { journeyConcept } from '../content/journeyGuide';
import { siteConfig } from '../content/siteConfig';

const journeyStopPaths = [
  '/ai-basics',
  '/jimeng-short-video',
  '/doll-maker',
  '/travel-planner',
  '/notebooklm',
  '/sticker-lab'
];

if (siteConfig.featureFlags.enableVoting) {
  journeyStopPaths.push('/voting');
}

const journeyStops = journeyStopPaths
  .map((path) => navItems.find((item) => item.path === path))
  .filter((item) => item !== undefined);
---
<WorkshopLayout title="AI 旅遊規劃師工作坊" currentPath="/">
  <section class="hero hero-home">
    <div class="flight-path-bg">
      <svg width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M-20,60 C80,-10 240,180 420,30 C550,-80 720,120 900,40" stroke="var(--page-accent)" stroke-width="2" stroke-dasharray="6,6" opacity="0.4" />
        <svg class="flight-plane" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 2L11 13M22 2L15 22L11 13L2 9L22 2Z" />
        </svg>
      </svg>
    </div>
    <div style="position: relative; z-index: 1;">
      <p class="eyebrow"><Icon name="plane" size={16} style="margin-right: 4px;" /> AI 行程出發點</p>
      <h1>AI 旅遊規劃師工作坊</h1>
      <p>今天不是只聽課，而是跟著網站一步步完成短影音、公仔、旅遊研究與 LINE 貼圖素材，把 AI 變成回家也能帶上的生活旅伴。</p>
      <div class="actions">
        <a class="btn" href="/prep">開始我的 AI 旅行</a>
        <a class="btn alt" href="/ai-basics">前往第一站：AI 入門簡報</a>
        {siteConfig.featureFlags.enableVoting && (
          <a class="btn ghost" href="/voting">前往頒獎舞台</a>
        )}
      </div>
      <div class="hero-stats" aria-label="工作坊重點">
        <span><strong>3.5h</strong> 現場實作</span>
        <span><strong>7</strong> 個任務章</span>
        <span><strong>3</strong> 種可帶走成果</span>
      </div>
    </div>
    <div class="hero-media">
      <Image src={heroMain} alt="旅行桌面上有筆電、手機、地圖與旅行小物，呈現 AI 旅遊工作坊出發情境" loading="eager" decoding="async" />
    </div>
  </section>

  <section class="journey-logic-card">
    <div>
      <p class="eyebrow">新手先看這裡</p>
      <h2>{journeyConcept.title}</h2>
      <p>{journeyConcept.text}</p>
    </div>
    <div class="journey-logic-grid">
      <article>
        <strong>7 站任務章</strong>
        <p>從 AI 入門到作品分享的操作路線</p>
      </article>
      <article>
        <strong>3 個可帶走成果</strong>
        <p>課後能保存、分享、重做的作品</p>
      </article>
    </div>
  </section>

  <section class="journey-strip" aria-label="工作坊路線">
    {journeyStops.map((item, index) => (
      <a href={item.path} class="journey-stop">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <strong>{item.short}</strong>
      </a>
    ))}
  </section>

  <section class="section-heading">
    <p class="eyebrow"><Icon name="luggage" size={16} style="margin-right: 4px;" /> 你的行李清單：今天會帶走的 3 個成果</p>
    <h2>先建立共同語言，再做出作品</h2>
  </section>
  <section class="feature-grid">
    {homeOutcomes.map((item) => (
      <article class="card">
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </article>
    ))}
  </section>

  <section class="tool-grid">
    <article class="card itinerary-card">
      <p class="eyebrow">任務章路線</p>
      <h2>今天照這 7 站走</h2>
      <ul class="example-list">{journeyConcept.tasks.map((item) => <li>{item}</li>)}</ul>
    </article>
    <article class="card notice-card">
      <p class="eyebrow">成果整理</p>
      <h2>最後帶走這 3 類作品</h2>
      <ul class="example-list">{journeyConcept.outcomes.map((item) => <li>{item}</li>)}</ul>
    </article>
  </section>

  <section class="hero-gallery" style="margin: 32px 0;">
    <ImageCard src="/images/home/hero-slide-02.webp" alt="3D 公仔、旅遊規劃卡與旅行貼圖三種 AI 成果排成展示卡" eyebrow="成果預覽" title="今天帶走 3 個 AI 成果" text="先用可分享的作品建立信心，再回頭理解提示詞與工具分工。" ratio="16 / 9" tone="featured" />
    <ImageCard src="/images/home/outcomes-collage-01.webp" alt="旅遊工作坊成果拼貼，包含行程卡、公仔與貼圖素材" eyebrow="旅程收藏" title="把學習變成可保存的旅行紀念" text="每一站都會留下能下載、分享與延伸的素材。" ratio="16 / 9" tone="warm" />
  </section>

  <section class="two-col">
    <div class="card itinerary-card">
      <p class="eyebrow"><Icon name="map" size={16} style="margin-right: 4px;" /> 3.5 小時 AI 旅行路線</p>
      <h2>13:30-17:00</h2>
      <div class="timeline">
        {schedule.map(([time,item]) => (
          <div class="schedule-row"><strong>{time}</strong><span>{item}</span></div>
        ))}
      </div>
    </div>
    <div class="card notice-card">
      <p class="eyebrow"><Icon name="sparkles" size={16} style="margin-right: 4px;" /> 旅程互動預告</p>
      <h2>現場會一起完成</h2>
      <ul class="example-list">{homeInteractions.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section-heading">
    <p class="eyebrow">這場工作坊適合誰參加</p>
    <h2>不論你在哪個起點，都能帶走可重做的方法</h2>
  </section>
  <section class="feature-grid">
    {homeAudience.map((item) => (
      <article class="card">
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </article>
    ))}
  </section>
</WorkshopLayout>
