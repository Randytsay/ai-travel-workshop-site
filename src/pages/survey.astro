---
import WorkshopLayout from '../layouts/WorkshopLayout.astro';
import CTASection from '../components/common/CTASection.astro';
import { siteConfig } from '../content/siteConfig';
---

<WorkshopLayout title="課後問卷" currentPath="/survey">
  <section class="hero with-image">
    <div>
      <p class="eyebrow">📋 旅程最後一站</p>
      <h1>課後體驗與意見回饋</h1>
      <p>感謝您參與今天的 AI 旅遊規劃師工作坊！請花 1 分鐘填寫以下問卷，您的寶貴建議將幫助我們持續優化後續的活動體驗。</p>
      
      <!-- 填寫前講義預告 -->
      <div class="gift-preview" style="background: #fff5f2; border: 2px dashed var(--sunset); border-radius: 12px; padding: 16px; margin-top: 16px; max-width: 540px; box-shadow: var(--shadow-sm);">
        <h4 style="margin: 0 0 6px 0; color: var(--sunset); font-size: 0.95rem; font-weight: 800; display: flex; align-items: center; gap: 6px;">
          🎁 填完即送：3.5H 實戰課後講義
        </h4>
        <p style="margin: 0; font-size: 0.88rem; color: var(--ink-dark); line-height: 1.5;">
          填寫問卷即可解鎖「精美圖文網頁版講義」與「完整版 PDF 講義下載」，方便您回家隨時複習！
        </p>
      </div>
    </div>
    <div class="hero-media">
      <img src="/images/survey/q.png" alt="工作坊結尾的旅行桌面，呈現完成旅程的溫暖感" loading="eager" decoding="async" />
    </div>
  </section>

  <!-- Form Screen -->
  <div class="form-screen" id="form-screen" style="margin-top: 32px;">
    <section class="card" style="overflow: hidden; padding: 0;">
      <div class="card-header" id="form-header" style="background: linear-gradient(135deg, var(--sunset), #ffb199); color: #fff; padding: 24px; position: relative;">
        <div class="card-header-flex" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
          <div>
            <h3 style="margin: 0; font-size: 1.35rem; font-weight: 800; color: #fff;" id="survey-title">🌸 新朋友體驗回饋</h3>
            <p style="margin: 6px 0 0 0; font-size: 0.85rem; opacity: 0.9; color: rgba(255,255,255,0.9);" id="survey-subtitle">填完即可解鎖網頁版及 PDF 精美實操講義！</p>
          </div>
          <div class="role-switcher">
            <button type="button" class="active" id="role-guest">👋 新朋友</button>
            <button type="button" id="role-member">🤝 夥伴</button>
          </div>
        </div>
      </div>
      <div class="card-body" style="padding: 28px; background: #fff;">
        <form id="survey-form">
          <!-- 0. 姓名 (共用) -->
          <div class="form-group">
            <label class="form-label">您的姓名</label>
            <input type="text" id="name" class="form-input" placeholder="請輸入個人姓名" required />
          </div>

          <!-- ===== 新朋友版題目 ===== -->
          <div id="guest-questions">
            <!-- 1. 邀請人 -->
            <div class="form-group">
              <label class="form-label">1. 邀請您參加的朋友是？</label>
              <input type="text" id="inviter" class="form-input" placeholder="請輸入邀請人姓名" required />
            </div>

            <!-- 2. 吸收程度 -->
            <div class="form-group">
              <label class="form-label">2. 您覺得自己今天對課程內容的吸收程度？ (1-5分)</label>
              <div class="rating-group-10" id="rating-absorption-guest">
                <button type="button" class="rating-btn-10" data-value="1">1</button>
                <button type="button" class="rating-btn-10" data-value="2">2</button>
                <button type="button" class="rating-btn-10" data-value="3">3</button>
                <button type="button" class="rating-btn-10" data-value="4">4</button>
                <button type="button" class="rating-btn-10" data-value="5">5</button>
              </div>
              <div style="text-align: center; font-size: 0.75rem; color: var(--ink-soft); margin-top: 6px;">1=完全聽不懂 ~ 5=收穫滿滿，完全掌握</div>
            </div>

            <!-- 3. 整體評分 -->
            <div class="form-group">
              <label class="form-label">3. 今天的 AI 旅遊規劃教學，滿分 5 分您給幾分？</label>
              <div class="rating-group-10" id="rating-overall">
                <button type="button" class="rating-btn-10" data-value="1">1</button>
                <button type="button" class="rating-btn-10" data-value="2">2</button>
                <button type="button" class="rating-btn-10" data-value="3">3</button>
                <button type="button" class="rating-btn-10" data-value="4">4</button>
                <button type="button" class="rating-btn-10" data-value="5">5</button>
              </div>
              <div style="text-align: center; font-size: 0.75rem; color: var(--ink-soft); margin-top: 6px;">1=非常不滿意 ~ 5=非常滿意</div>
            </div>

            <!-- 4. Wow Moment -->
            <div class="form-group">
              <label class="form-label">4. 今天哪個部分讓您覺得最驚艷 (Wow Moment)？</label>
              <select id="wow-moment" class="form-select">
                <option value="">請選擇</option>
                <option value="AI 一鍵生成行程">AI 一鍵生成行程</option>
                <option value="3D 頭貼製作">3D 頭貼製作</option>
                <option value="AI 簡報生成">AI 簡報生成</option>
                <option value="AI podcast">AI podcast</option>
                <option value="AI 旅遊地圖">AI 旅遊地圖</option>
                <option value="LINE貼圖製作">LINE貼圖製作</option>
                <option value="消費轉收入（智慧消費）概念">消費轉收入（智慧消費）概念</option>
              </select>
            </div>

            <!-- 5. AI 興趣主題 -->
            <div class="form-group">
              <label class="form-label">5. 未來若有其他 AI 生活應用主題，您對哪個感興趣？</label>
              <div class="checkbox-group" id="ai-interests">
                <label class="checkbox-item">
                  <input type="checkbox" value="科學體態管理 x 香氛微沙龍" /> 🥗 科學體態管理 x 香氛微沙龍
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" value="健康保健 x 營養補充" /> 💊 健康保健 x 營養補充
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" value="保養美容 x 美妝" /> 💅 保養美容 x 美妝
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" value="AI 工具 x 生活效率" /> ⚡ AI 工具 x 生活效率
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" value="職涯成長 x 職場資訊" /> 📈 職涯成長 x 職場資訊
                </label>
              </div>
            </div>

            <!-- 6. Shop.com 興趣 -->
            <div class="form-group">
              <label class="form-label">6. 今天的「消費轉收入」概念，您有興趣進一步了解嗎？</label>
              <select id="shopcom-interest" class="form-select">
                <option value="">請選擇</option>
                <option value="非常有興趣，想了解如何開始">🤩 非常有興趣，想了解如何開始</option>
                <option value="有點興趣，想先聽聽看制度">🤔 有點興趣，想先聽聽看制度</option>
                <option value="只想當消費者，賺現金回饋就好">🛒 只想當消費者，賺現金回饋就好</option>
                <option value="目前先專注學習 AI 技能就好">💻 目前先專注學習 AI 技能就好</option>
              </select>
            </div>

            <!-- 7. 推薦意願 -->
            <div class="form-group">
              <label class="form-label">7. 您會推薦朋友來參加這個工作坊嗎？</label>
              <div class="rating-group-10" id="rating-recommend">
                <button type="button" class="rating-btn-10" data-value="1">1</button>
                <button type="button" class="rating-btn-10" data-value="2">2</button>
                <button type="button" class="rating-btn-10" data-value="3">3</button>
                <button type="button" class="rating-btn-10" data-value="4">4</button>
                <button type="button" class="rating-btn-10" data-value="5">5</button>
              </div>
              <div style="text-align: center; font-size: 0.75rem; color: var(--ink-soft); margin-top: 6px;">1=絕對不會 ~ 5=一定會</div>
            </div>

            <!-- 8. 新朋友建議 (合併至夥伴下次建議的 nextSuggestion 欄位) -->
            <div class="form-group">
              <label class="form-label">8. 您對本次工作坊有任何建議或想說的話嗎？</label>
              <textarea id="guest-suggestion" class="form-textarea" rows="3" placeholder="歡迎留下您對場地、時間、內容的任何建議與回饋..."></textarea>
            </div>
          </div>

          <!-- ===== 夥伴版題目 ===== -->
          <div id="member-questions" style="display: none;">
            <!-- 1. 流程順暢度 -->
            <div class="form-group">
              <label class="form-label">1. 今日活動流程順暢度</label>
              <select id="flow-rating" class="form-select">
                <option value="">請選擇</option>
                <option value="5">5 - 非常順暢</option>
                <option value="4">4 - 順暢</option>
                <option value="3">3 - 普通</option>
                <option value="2">2 - 有些卡頓</option>
                <option value="1">1 - 需要改進</option>
              </select>
            </div>

            <!-- 2. 吸收程度 -->
            <div class="form-group">
              <label class="form-label">2. 您覺得自己今天對課程內容的吸收程度？ (1-5分)</label>
              <div class="rating-group-10" id="rating-absorption-member">
                <button type="button" class="rating-btn-10" data-value="1">1</button>
                <button type="button" class="rating-btn-10" data-value="2">2</button>
                <button type="button" class="rating-btn-10" data-value="3">3</button>
                <button type="button" class="rating-btn-10" data-value="4">4</button>
                <button type="button" class="rating-btn-10" data-value="5">5</button>
              </div>
              <div style="text-align: center; font-size: 0.75rem; color: var(--ink-soft); margin-top: 6px;">1=完全聽不懂 ~ 5=收穫滿滿，完全掌握</div>
            </div>

            <!-- 3. AI 銜接 Shop.com 轉場 -->
            <div class="form-group">
              <label class="form-label">3. 關於「AI 技能」銜接 shop.com 事業」的轉場，您覺得？</label>
              <select id="transition-feedback" class="form-select">
                <option value="">請選擇</option>
                <option value="很自然，朋友不會覺得突兀">很自然，朋友不會覺得突兀</option>
                <option value="還可以，但可以更順一點">還可以，但可以更順一點</option>
                <option value="有點生硬，朋友可能會覺得在推銷">有點生硬，朋友可能會覺得在推銷</option>
              </select>
            </div>

            <!-- 4. 新朋友反應 -->
            <div class="form-group">
              <label class="form-label">4. 您觀察到您帶來的新朋友，反應最熱烈的是？</label>
              <input type="text" id="guest-reaction" class="form-input" placeholder="例如：手繪地圖時大家都在驚呼..." />
            </div>

            <!-- 5. 下次建議 -->
            <div class="form-group">
              <label class="form-label">5. 下次舉辦的建議：</label>
              <textarea id="next-suggestion" class="form-textarea" rows="3" placeholder="場地、時間、內容等任何建議..."></textarea>
            </div>
          </div>

          <button type="submit" class="btn" style="width: 100%; padding: 14px; font-size: 1rem; background: var(--sunset); color: #fff; border: 0; box-shadow: var(--shadow-button); border-radius: 12px; margin-top: 24px; cursor: pointer; font-weight: 800;" id="submit-btn">
            📤 提交問卷
          </button>
        </form>
      </div>
    </section>
  </div>

  <!-- Success Screen -->
  <div class="success-screen" id="success-screen" style="display: none; text-align: center; margin-top: 32px;">
    <section class="card" style="background: #fff; padding: 40px 24px; max-width: 600px; margin: 0 auto;">
      <div style="font-size: 4rem; margin-bottom: 16px;">🎉</div>
      <h2 style="font-size: 1.75rem; font-weight: 800; color: var(--night); margin: 0 0 12px 0;">問卷已成功提交！</h2>
      <p style="color: var(--ink-soft); margin: 0 0 32px 0; font-size: 0.95rem;">感謝您的寶貴回饋，以下為您的專屬課後講義禮物：</p>
      
      <!-- 講義領取專區 -->
      <div style="background: #fffdfb; border: 2px dashed var(--sunset); border-radius: 16px; padding: 24px; margin-bottom: 32px; text-align: left;">
        <h4 style="margin: 0 0 12px 0; color: var(--sunset); font-size: 1.1rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
          📚 AI 旅遊規劃師 課後實操講義
        </h4>
        <p style="margin: 0 0 20px 0; font-size: 0.9rem; color: var(--ink-dark); line-height: 1.6;">
          內含今日 3D 可愛公仔生圖咒語、AI 旅遊規劃 5 步流程、NotebookLM 使用框架，以及 LINE 貼圖製作教學。
        </p>
        
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <!-- 線上直接看 -->
          <a href="/handbook_v2.html" target="_blank" rel="noopener noreferrer" class="btn" style="background: var(--sunset); color: #fff; border: 0; padding: 14px; border-radius: 12px; font-weight: 800; text-align: center; display: block; text-decoration: none; transition: all 0.2s; box-shadow: var(--shadow-button);">
            📖 直接線上閱讀 (網頁版)
          </a>
          
          <!-- PDF 下載 -->
          <a href="/AI_Travel_Planner_Workshop_Handout.pdf" download="AI 旅遊規劃師工作坊 課後講義.pdf" class="btn" style="background: var(--ocean); color: #fff; border: 0; padding: 14px; border-radius: 12px; font-weight: 800; text-align: center; display: block; text-decoration: none; transition: all 0.2s;">
            📥 打包下載完整 PDF 講義
          </a>
        </div>
        
        <p style="margin: 16px 0 0 0; font-size: 0.8rem; color: var(--ink-soft); text-align: center; line-height: 1.4;">
          💡 貼心提醒：可以把這份網頁講義的連結分享給帶您來的朋友，一起研究討論喔！
        </p>
      </div>

      <a href="/" class="btn" style="background: #6c757d; color: #fff; border: 0; padding: 12px 28px; border-radius: 999px; font-weight: 800; text-decoration: none; display: inline-block;">🏠 回到首頁</a>
    </section>
  </div>

  <CTASection 
    title="下段旅程見" 
    text="課後可以依照網站導航重新操作一次，把今天的魔法變成自己的日常裝備。" 
    primaryLabel="回到旅行入口 (首頁)" 
    primaryHref="/" 
    secondaryLabel={siteConfig.featureFlags.enableGallery ? "查看明信片牆" : "回到貼圖工坊"} 
    secondaryHref={siteConfig.featureFlags.enableGallery ? "/gallery" : "/sticker-lab"} 
  />
</WorkshopLayout>

<style>
  .rating-group-10 {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 8px;
  }

  .rating-btn-10 {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 2px solid #e8e8e8;
    background: #fff;
    cursor: pointer;
    font-weight: 700;
    font-size: 1rem;
    color: var(--night);
    transition: all 0.2s ease;
  }

  .rating-btn-10:hover {
    border-color: var(--sunset);
    background: #fff5f2;
  }

  .rating-btn-10.selected {
    background: var(--sunset) !important;
    color: #fff !important;
    border-color: var(--sunset) !important;
    transform: scale(1.1);
    box-shadow: 0 4px 12px rgba(255, 122, 92, 0.35);
  }

  .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }

  .checkbox-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: #fbfbfb;
    border: 2px solid #e8e8e8;
    border-radius: 12px;
    cursor: pointer;
    font-size: 0.92rem;
    transition: all 0.25s ease;
  }

  .checkbox-item:hover {
    background: #fff5f2;
    border-color: rgba(255, 122, 92, 0.4);
  }

  .checkbox-item input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--sunset);
    cursor: pointer;
  }

  .checkbox-item:has(input[type="checkbox"]:checked) {
    background: #fff5f2;
    border-color: var(--sunset);
    font-weight: 700;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--night);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    border: 2px solid #e8e8e8;
    background: #fafafa;
    border-radius: 12px;
    padding: 11px 16px;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--night);
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--sunset);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(255, 122, 92, 0.15);
    outline: none;
  }

  .role-switcher {
    display: inline-flex;
    background: rgba(0, 0, 0, 0.12);
    padding: 3px;
    border-radius: 50px;
  }

  .role-switcher button {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .role-switcher button.active {
    background: #fff;
    color: var(--sunset);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  import { markTaskComplete, isTaskComplete } from '../utils/progressStore';
  import { siteConfig } from '../content/siteConfig';

  function initSurvey() {
    let currentRole = 'guest';
    const ratings: Record<string, number> = {
      overall: 0,
      recommend: 0,
      absorptionGuest: 0,
      absorptionMember: 0
    };

    const btnGuest = document.getElementById('role-guest') as HTMLButtonElement | null;
    const btnMember = document.getElementById('role-member') as HTMLButtonElement | null;
    const guestQuestions = document.getElementById('guest-questions') as HTMLDivElement | null;
    const memberQuestions = document.getElementById('member-questions') as HTMLDivElement | null;
    const surveyTitle = document.getElementById('survey-title') as HTMLHeadingElement | null;
    const surveySubtitle = document.getElementById('survey-subtitle') as HTMLParagraphElement | null;
    const inviterInput = document.getElementById('inviter') as HTMLInputElement | null;
    const surveyForm = document.getElementById('survey-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    // 取得需要動態 required 的欄位
    const wowSelect = document.getElementById('wow-moment') as HTMLSelectElement | null;
    const shopSelect = document.getElementById('shopcom-interest') as HTMLSelectElement | null;
    const flowSelect = document.getElementById('flow-rating') as HTMLSelectElement | null;
    const transitionSelect = document.getElementById('transition-feedback') as HTMLSelectElement | null;
    const guestReactionInput = document.getElementById('guest-reaction') as HTMLInputElement | null;

    if (!surveyForm) return; // 確保在其他頁面不執行

    function switchRole(role: 'guest' | 'member') {
      currentRole = role;
      if (btnGuest && btnMember && surveyTitle && surveySubtitle && guestQuestions && memberQuestions) {
        btnGuest.classList.toggle('active', role === 'guest');
        btnMember.classList.toggle('active', role === 'member');

        if (role === 'guest') {
          surveyTitle.textContent = '🌸 新朋友體驗回饋';
          surveySubtitle.textContent = '請完成問卷以提交您的想法！';
          guestQuestions.style.display = 'block';
          memberQuestions.style.display = 'none';
          if (inviterInput) inviterInput.setAttribute('required', '');

          if (wowSelect) wowSelect.setAttribute('required', '');
          if (shopSelect) shopSelect.setAttribute('required', '');
          if (flowSelect) flowSelect.removeAttribute('required');
          if (transitionSelect) transitionSelect.removeAttribute('required');
          if (guestReactionInput) guestReactionInput.removeAttribute('required');
        } else {
          surveyTitle.textContent = '🤝 夥伴流程優化回饋';
          surveySubtitle.textContent = '感謝您的協助，讓活動越來越好！';
          guestQuestions.style.display = 'none';
          memberQuestions.style.display = 'block';
          if (inviterInput) inviterInput.removeAttribute('required');

          if (wowSelect) wowSelect.removeAttribute('required');
          if (shopSelect) shopSelect.removeAttribute('required');
          if (flowSelect) flowSelect.setAttribute('required', '');
          if (transitionSelect) transitionSelect.setAttribute('required', '');
          if (guestReactionInput) guestReactionInput.setAttribute('required', '');
        }
      }
    }

    btnGuest?.addEventListener('click', () => switchRole('guest'));
    btnMember?.addEventListener('click', () => switchRole('member'));

    // 初始化呼叫一次以綁定預設 required
    switchRole('guest');

    // Rating buttons logic
    document.querySelectorAll('.rating-group-10').forEach(group => {
      group.querySelectorAll('.rating-btn-10').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const val = parseInt((btn as HTMLButtonElement).dataset.value || '0');
          const groupId = group.id.replace('rating-', '');

          let targetKey = groupId;
          if (groupId === 'absorption-guest') targetKey = 'absorptionGuest';
          if (groupId === 'absorption-member') targetKey = 'absorptionMember';

          ratings[targetKey] = val;

          group.querySelectorAll('.rating-btn-10').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
        });
      });
    });

    function getSelectedInterests() {
      const checkboxes = document.querySelectorAll('#ai-interests input[type="checkbox"]:checked');
      return Array.from(checkboxes).map(cb => (cb as HTMLInputElement).value).join(', ');
    }



    surveyForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      // 新朋友額外欄位必選檢查
      if (currentRole === 'guest') {
        if (!ratings.absorptionGuest) {
          alert('請勾選「2. 您覺得自己今天對課程內容的吸收程度？」');
          return;
        }
        if (!ratings.overall) {
          alert('請勾選「3. 今天的 AI 旅遊規劃教學，您給幾分？」');
          return;
        }
        if (!getSelectedInterests()) {
          alert('請至少勾選一項「5. 未來感興趣的 AI 生活應用主題」');
          return;
        }
        if (!ratings.recommend) {
          alert('請勾選「7. 您會推薦朋友來參加這個工作坊嗎？」');
          return;
        }
      }

      // 夥伴額外欄位必選檢查
      if (currentRole === 'member') {
        if (!ratings.absorptionMember) {
          alert('請勾選「2. 您覺得自己今天對課程內容的吸收程度？」');
          return;
        }
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        const origText = submitBtn.textContent;
        submitBtn.textContent = '⏳ 提交中...';

        const guestSugEl = document.getElementById('guest-suggestion') as HTMLTextAreaElement | null;
        const memberSugEl = document.getElementById('next-suggestion') as HTMLTextAreaElement | null;

        const data: Record<string, string | number> = {
          timestamp: new Date().toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' }),
          role: currentRole === 'guest' ? '新朋友' : '夥伴',
          name: (document.getElementById('name') as HTMLInputElement).value,
          inviter: currentRole === 'guest' ? (inviterInput?.value || '') : '',
          ratingAbsorptionGuest: currentRole === 'guest' ? ratings.absorptionGuest : '',
          ratingOverall: currentRole === 'guest' ? ratings.overall : '',
          wowMoment: currentRole === 'guest' ? (document.getElementById('wow-moment') as HTMLSelectElement).value : '',
          aiInterests: currentRole === 'guest' ? getSelectedInterests() : '',
          shopcomInterest: currentRole === 'guest' ? (document.getElementById('shopcom-interest') as HTMLSelectElement).value : '',
          ratingRecommend: currentRole === 'guest' ? ratings.recommend : '',
          flowRating: currentRole === 'member' ? (document.getElementById('flow-rating') as HTMLSelectElement).value : '',
          ratingAbsorptionMember: currentRole === 'member' ? ratings.absorptionMember : '',
          transitionFeedback: currentRole === 'member' ? (document.getElementById('transition-feedback') as HTMLSelectElement).value : '',
          guestReaction: currentRole === 'member' ? (document.getElementById('guest-reaction') as HTMLInputElement).value : '',
          // 合併到同一個 column nextSuggestion
          nextSuggestion: currentRole === 'guest' ? (guestSugEl?.value || '') : (memberSugEl?.value || ''),
        };

        if (!siteConfig.surveyApiUrl) {
          alert('尚未設定 Google Sheets API 連結，請先參考說明設定。');
          submitBtn.disabled = false;
          submitBtn.textContent = origText;
          return;
        }

        try {
          const params = new URLSearchParams();
          for (const key in data) {
            params.append(key, String(data[key]));
          }

          await fetch(siteConfig.surveyApiUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: params.toString()
          });

          // 標記任務完成
          markTaskComplete('survey-complete');

          const formScreen = document.getElementById('form-screen');
          const successScreen = document.getElementById('success-screen');
          if (formScreen && successScreen) {
            formScreen.style.display = 'none';
            successScreen.style.display = 'block';
          }
        } catch (err) {
          alert('提交失敗，請檢查網路連線後再試。');
          console.error(err);
          submitBtn.disabled = false;
          submitBtn.textContent = origText;
        }
      }
    });
  }

  // 監聽 astro:page-load 事件以相容 View Transitions 導航
  document.addEventListener('astro:page-load', initSurvey);
</script>
