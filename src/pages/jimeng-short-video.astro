---
import fs from 'node:fs';
import path from 'node:path';
import WorkshopLayout from '../layouts/WorkshopLayout.astro';
import AssetPlaceholder from '../components/common/AssetPlaceholder.astro';
import CompleteTaskButton from '../components/progress/CompleteTaskButton.astro';
import StationRole from '../components/common/StationRole.astro';
import Icon from '../components/common/Icon.astro';
import { stationRoles } from '../content/journeyGuide';
import {
  androidSteps,
  faqItems,
  iosSteps,
  officialLinks,
  sameStyleSteps,
  screenshotAssetFolder,
  screenshotChecklist,
  setupSummary,
  tutorialReferences
} from '../content/jimengShortVideoPage';

const hasImage = (filename: string) => {
  if (!filename) return false;
  try {
    const localPath = path.join(process.cwd(), 'public', screenshotAssetFolder, filename);
    return fs.existsSync(localPath);
  } catch (e) {
    return false;
  }
};
---
<WorkshopLayout title="即夢短影音體驗" currentPath="/jimeng-short-video">
  <section class="hero jimeng-hero">
    <div>
      <p class="eyebrow">短影音實作</p>
      <h1>用即夢做出自己的同款影片</h1>
      <p>這一站先把手機安裝、登入驗證與素材準備整理好，再用「做同款」把範例短影音變成自己的作品。截圖區保留給課前實機補拍，避免拿假的 App 畫面教學。</p>
      <div class="actions">
        <a class="btn" href="#ios-flow">iOS 流程</a>
        <a class="btn alt" href="#android-flow">Android 流程</a>
        <a class="btn ghost" href="#screenshot-list">截圖清單</a>
      </div>
    </div>
    <div class="jimeng-hero-media" aria-label="短影音工作坊情境示意">
      <img src="/images/jimeng/hero-workshop-scene-01.webp" alt="手機短影音創作工作坊情境，桌面上有手機、筆電與分鏡素材" loading="eager" decoding="async" />
      <div class="phone-demo" aria-hidden="true">
        <div class="phone-shell">
          <div class="phone-screen">
            <span>AI Video</span>
            <strong>做同款</strong>
            <p>範例 / 素材 / 生成</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <StationRole role={stationRoles['/jimeng-short-video']} />

  <section class="tool-grid">{setupSummary.map((item) => <article class="card setup-card"><h2>{item.title}</h2><p>{item.text}</p></article>)}</section>

  <section class="jimeng-classroom-strip" aria-label="課堂安全流程">
    <span>1. 先確認帳號與下載來源</span>
    <span>2. 用測試素材練習做同款</span>
    <span>3. 生成後先保存，不急著公開發布</span>
  </section>

  <section class="section-heading" id="ios-flow">
    <p class="eyebrow">iPhone / iOS</p>
    <h2>先切換 App Store 地區，再下載即夢AI與抖音</h2>
  </section>
  <section class="guide-flow">
    {iosSteps.map((step, index) => (
      <article class="guide-step">
        <div class="step-index">{String(index + 1).padStart(2, '0')}</div>
        <div class="guide-copy">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          {step.filename && !hasImage(step.filename) && <p class="shot-note">建議截圖：{step.shot}</p>}
        </div>
        {step.filename && (
          <AssetPlaceholder title={step.title} text={step.shot} type="圖片" filename={`${screenshotAssetFolder}${step.filename}`} />
        )}
      </article>
    ))}
  </section>

  <section class="section-heading" id="android-flow">
    <p class="eyebrow">Android</p>
    <h2>從官方入口下載 APK，安裝後完成登入</h2>
  </section>
  
  <div class="card boarding-pass-card android-download-card">
    <div class="download-content">
      <div class="download-text">
        <p><strong>🤖 Android 快捷下載通道（優先使用）</strong></p>
        <p>請點擊下方按鈕，直接下載安裝包（無速度限制、現場高速下載）：</p>
        <div class="download-actions" style="margin-top: 16px; display: flex; flex-wrap: wrap; gap: 12px;">
          <a class="btn" href="https://github.com/Randytsay/ai-travel-workshop-site/releases/download/38.7.0/douyin.apk" download style="min-height: 44px; padding: 10px 18px; font-size: 0.9rem;">
            <Icon name="sparkles" size={14} style="margin-right: 6px;" /> 下載 抖音 APK
          </a>
          <a class="btn alt" href="https://github.com/Randytsay/ai-travel-workshop-site/releases/download/38.7.0/dreamina.apk" download style="min-height: 44px; padding: 10px 18px; font-size: 0.9rem;">
            <Icon name="sparkles" size={14} style="margin-right: 6px;" /> 下載 即夢 AI APK
          </a>
        </div>
        <div class="backup-info" style="margin-top: 20px; padding-top: 16px; border-top: 1px dashed var(--line);">
          <p style="font-size: 0.9rem; margin-bottom: 4px; color: var(--night);"><strong>☁️ 雲端備用通道（主通道異常時使用）</strong></p>
          <p style="font-size: 0.82rem; margin-bottom: 8px;">如果上方直接下載無反應，請點擊按鈕前往 Google 雲端硬碟下載：</p>
          <a class="route-link" href="https://drive.google.com/drive/folders/17zfY5DSgK-mws83oZ5fO3hCcjwuf5p-G?usp=sharing" target="_blank" rel="noopener noreferrer" style="font-size: 0.8rem; padding: 6px 12px; display: inline-flex; align-items: center; gap: 6px;">
            <Icon name="map" size={12} /> 開啟 Google 雲端備用目錄
          </a>
        </div>
      </div>
      <div class="download-qr-wrap">
        <div class="download-qrs-container">
          <div class="qr-item">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https%3A%2F%2Fgithub.com%2FRandytsay%2Fai-travel-workshop-site%2Freleases%2Fdownload%2F38.7.0%2Fdouyin.apk" alt="抖音 APK 下載 QR Code" class="download-qr step-real-image" />
            <span class="qr-label">抖音 APK</span>
          </div>
          <div class="qr-item">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https%3A%2F%2Fgithub.com%2FRandytsay%2Fai-travel-workshop-site%2Freleases%2Fdownload%2F38.7.0%2Fdreamina.apk" alt="即夢 AI APK 下載 QR Code" class="download-qr step-real-image" />
            <span class="qr-label">即夢 AI APK</span>
          </div>
        </div>
        <small class="qr-tip">📱 掃描二維碼或點擊放大下載</small>
      </div>
    </div>
  </div>

  <section class="guide-flow">
    {androidSteps.map((step, index) => (
      <article class="guide-step">
        <div class="step-index">{String(index + 1).padStart(2, '0')}</div>
        <div class="guide-copy">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          {step.filename && !hasImage(step.filename) && <p class="shot-note">建議截圖：{step.shot}</p>}
        </div>
        {step.filename && (
          <AssetPlaceholder title={step.title} text={step.shot} type="圖片" filename={`${screenshotAssetFolder}${step.filename}`} />
        )}
      </article>
    ))}
  </section>

  <section class="section-heading" id="co-play-flow">
    <p class="eyebrow">🤝 課堂互動</p>
    <h2>即夢加好友共演</h2>
  </section>
  <section class="card boarding-pass-card co-play-card">
    <div class="co-play-content">
      <div class="co-play-text">
        <p><strong>完成即夢 AI 安裝與登入後，歡迎與講師加為好友！</strong></p>
        <p>我們將在課堂上一起進行多人共同創作與合影演繹，體驗多人協作共演（Co-play）的 AI 短影音樂趣！</p>
        <div class="co-play-actions" style="margin-top: 20px;">
          <a class="btn" href="https://m.jimeng.jianying.com/s/vQBM214rBQs/?t=0" target="_blank" rel="noopener noreferrer">
            <Icon name="sparkles" size={16} style="margin-right: 8px;" /> 點此連結加入即夢好友
          </a>
        </div>
      </div>
      <div class="co-play-qr-wrap">
        <img src="/images/jimeng/friend-qr.jpg" alt="即夢好友 QR Code" class="co-play-qr step-real-image" />
        <small class="qr-tip">📱 掃描二維碼或點擊圖片放大</small>
      </div>
    </div>
  </section>

  <section class="section-heading" id="same-style-flow">
    <p class="eyebrow">課堂體驗</p>
    <h2>用「做同款」完成第一支短影音</h2>
  </section>
  <section class="guide-flow">
    {sameStyleSteps.map((step, index) => (
      <article class="guide-step">
        <div class="step-index">{String(index + 1).padStart(2, '0')}</div>
        <div class="guide-copy">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          {step.filename && !hasImage(step.filename) && <p class="shot-note">建議截圖：{step.shot}</p>}
        </div>
        {step.filename && (
          <AssetPlaceholder title={step.title} text={step.shot} type="圖片" filename={`${screenshotAssetFolder}${step.filename}`} />
        )}
      </article>
    ))}
  </section>

  <section class="two-col screenshot-section" id="screenshot-list">
    <section class="card postcard-card">
      <p class="eyebrow">教學設計</p>
      <h2>截圖清單</h2>
      <ul class="example-list">
        {screenshotChecklist.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section class="card notice-card">
      <p class="eyebrow">教學參考</p>
      <h2>學習資源與手冊</h2>
      {tutorialReferences.map((item) => (
        <a class="reference-card" href={item.href} target="_blank" rel="noreferrer">
          <span>{item.source}</span>
          <h3>{item.label}</h3>
          <p>{item.note}</p>
        </a>
      ))}
    </section>
  </section>
  <p class="disclaimer-text">外部教學內容以連結方式提供；頁面截圖建議以自己的手機重拍後替換，避免使用他人網站或影片畫面。</p>

  <section class="section-heading">
    <p class="eyebrow">常見卡關</p>
    <h2>現場助教可以照這裡排除</h2>
  </section>
  <section class="faq-grid">
    {faqItems.map((item) => (
      <article class="card faq-lite">
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </article>
    ))}
  </section>

  <section class="section-heading">
    <p class="eyebrow">官方來源</p>
    <h2>頁面內容依這些入口整理</h2>
  </section>
  <section class="source-list">
    {officialLinks.map((link) => (
      <a class="source-item" href={link.href} target="_blank" rel="noreferrer">
        <strong>{link.label}</strong>
        <span>{link.note}</span>
      </a>
    ))}
  </section>

  <CompleteTaskButton
    taskId="jimeng-short-video-complete"
    buttonLabel="我已完成即夢短影音體驗"
    nextLabel="3D 公仔"
    nextHref="/doll-maker"
    successMessage="太棒了！你已經完成短影音暖身，接下來可以進入 3D 公仔創作。"
  />
</WorkshopLayout>

<style>
  .co-play-card {
    border-left-color: var(--page-accent, var(--sunset)) !important;
    padding: 32px;
    background: #ffffff;
    margin-bottom: 32px;
  }
  .co-play-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 32px;
    align-items: center;
  }
  .co-play-text p {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }
  .co-play-text strong {
    color: var(--night);
    font-size: 1.2rem;
  }
  .co-play-qr-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 18px;
    box-shadow: var(--shadow-soft);
  }
  .co-play-qr {
    max-width: 180px;
    height: auto;
    border-radius: var(--radius-sm);
    border: 4px solid #fff;
    box-shadow: var(--shadow-soft);
    cursor: zoom-in;
    transition: transform 0.2s;
  }
  .co-play-qr:hover {
    transform: scale(1.03);
  }
  .qr-tip {
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 700;
  }
  @media (max-width: 768px) {
    .co-play-content {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .co-play-qr-wrap {
      max-width: 240px;
      margin: 0 auto;
    }
  }

  /* Android Download Card CSS */
  .android-download-card {
    border-left-color: var(--page-accent, var(--sunset)) !important;
    padding: 32px;
    background: #ffffff;
    margin-bottom: 32px;
  }
  .download-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    align-items: center;
  }
  .download-text p {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }
  .download-text strong {
    color: var(--night);
    font-size: 1.2rem;
  }
  .download-qr-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 18px;
    box-shadow: var(--shadow-soft);
  }
  .download-qrs-container {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    width: 100%;
    margin-bottom: 8px;
  }
  .qr-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .qr-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .download-qr {
    max-width: 130px;
    height: auto;
    border-radius: var(--radius-sm);
    border: 4px solid #fff;
    box-shadow: var(--shadow-soft);
    cursor: zoom-in;
    transition: transform 0.2s;
  }
  .download-qr:hover {
    transform: scale(1.03);
  }
  @media (max-width: 768px) {
    .download-content {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .download-qr-wrap {
      max-width: 100%;
      margin: 0 auto;
    }
  }
</style>
