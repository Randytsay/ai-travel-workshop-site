---
import WorkshopLayout from '../layouts/WorkshopLayout.astro';
import CTASection from '../components/common/CTASection.astro';
import CompleteTaskButton from '../components/progress/CompleteTaskButton.astro';
import StationRole from '../components/common/StationRole.astro';
import { siteConfig } from '../content/siteConfig';
import { stationRoles } from '../content/journeyGuide';
---
<WorkshopLayout title="AI 旅遊規劃師" currentPath="/travel-planner">
  <section class="hero with-image">
    <div>
      <p class="eyebrow">🗺️ 第二站：目的地規劃</p>
      <h1>目的地規劃控制台</h1>
      <p>登機開啟專屬 GPT 航班，由 AI 旅遊規劃師引導您調查自由行需求。對話完成後，AI 會為您自動整理出核心需求，並可以直接用於下一階段的 NotebookLM 進行深度的研究。</p>
    </div>
    <div class="hero-media">
      <img src="/images/travel-planner/travel-planner-flow-01.webp" alt="AI 旅遊規劃流程，包含需求訪談、行程卡與地圖路線示意" loading="eager" decoding="async" />
    </div>
  </section>

  <StationRole role={stationRoles['/travel-planner']} />

  <section class="planner-actions-section" style="margin: 32px 0 48px; display: flex; justify-content: center;">
    <article class="card boarding-pass-card recommended-card" style="width: 100%; max-width: 650px; padding: 40px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; position: relative;">
      <p class="eyebrow">✈️ 專屬 GPT 航班</p>
      <h2 style="margin: 0; font-size: 1.8rem; color: var(--night);">ChatGPT 旅遊規劃師</h2>
      <p style="margin: 0; font-size: 1.05rem; color: #4a5568; line-height: 1.6; max-width: 500px;">
        點擊下方按鈕開啟專屬的 GPTs。請回答 AI 規劃師提出的問題，它會引導您整理出自由行的核心需求摘要，方便您用於下一階段的研究。
      </p>
      <div style="margin-top: 12px; width: 100%; display: flex; justify-content: center;">
        <a class="btn" target="_blank" rel="noreferrer" href={siteConfig.externalLinks.travelPlannerGptUrl} style="padding: 12px 36px; font-size: 1.1rem; font-weight: 700; border-radius: var(--radius-md); box-shadow: 0 4px 14px rgba(255,122,92,0.3); text-decoration: none;">
          🚀 開啟 ChatGPT 規劃師
        </a>
      </div>
    </article>
  </section>

  <CompleteTaskButton 
    taskId="travel-planner-complete" 
    buttonLabel="我已完成旅遊需求調查"
    nextLabel="NotebookLM 研究報告" 
    nextHref="/notebooklm"
    successMessage="需求整理完成！這份摘要是下一關研究的關鍵，記得複製好喔。"
  />

  <CTASection
    title="請保留 NotebookLM 研究提示詞"
    text="下一頁會把剛剛整理好的旅遊需求交給 NotebookLM，做更深入的資料查證與行程研究。"
    primaryLabel="前往 NotebookLM 研究升級"
    primaryHref="/notebooklm"
    secondaryLabel="回到 旅遊人格頁"
    secondaryHref="/doll-maker"
  />
</WorkshopLayout>
