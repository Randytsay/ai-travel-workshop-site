---
import WorkshopLayout from '../layouts/WorkshopLayout.astro';
import StepCard from '../components/common/StepCard.astro';
import CTASection from '../components/common/CTASection.astro';
import ImageCard from '../components/common/ImageCard.astro';
import PromptCard from '../components/prompts/PromptCard.astro';
import CompleteTaskButton from '../components/progress/CompleteTaskButton.astro';
import StationRole from '../components/common/StationRole.astro';
import { notebookContent } from '../content/prompts';
import { notebookSteps } from '../content/workshopPages';
import { siteConfig } from '../content/siteConfig';
import { stationRoles } from '../content/journeyGuide';
import { pptScenarios, infographicStyles, podcastScenarios } from '../content/notebookStudio';

const deepResearchPrompt = notebookContent.prompts.find(p => p.id === 'deep-research')?.prompts.chatgpt || '';
---
<WorkshopLayout title="NotebookLM 研究升級" currentPath="/notebooklm">
  <section class="hero with-image">
    <div>
      <p class="eyebrow">📚 第三站：深度研究</p>
      <h1>旅遊研究資料室 (NotebookLM)</h1>
      <p>上一站整理出的簽證清單不是終點。把它交給這間研究室後，就能查證資訊、比較方案、產出行程、簡報與行前清單。</p>
      <div class="actions">
        <a class="btn" target="_blank" rel="noreferrer" href={siteConfig.externalLinks.notebookLmUrl}>開啟 NotebookLM</a>
        <button class="btn alt copy-btn" type="button" data-text={deepResearchPrompt}>複製 Deep Research 提示詞</button>
        <a class="btn ghost" href="#notebook-prompts">查看完整提示詞</a>
      </div>
    </div>
    <div class="hero-media">
      <img src="/images/notebooklm/hero-research-studio-01.webp" alt="NotebookLM 旅遊研究工作桌，包含地圖、資料卡與研究報告示意" loading="eager" decoding="async" />
    </div>
  </section>

  <StationRole role={stationRoles['/notebooklm']} />

  <section class="section-heading">
    <p class="eyebrow">📋 研究手冊</p>
    <h2>6 步把需求變成出發指南</h2>
  </section>
  <section class="step-grid">
    {notebookSteps.map(([title, text], index) => <StepCard index={index + 1} title={title} text={text} />)}
  </section>

  <section class="feature-grid">
    <article class="card notice-card" style="grid-column: 1 / -1;">
      <p class="eyebrow">🗺️ 導航流程圖</p>
      <h2>從聊天到簡報，研究室幫你處理資訊</h2>
      <div class="flow-highlight" style="margin-top:16px;">
        <span class="chip">需求總表</span> <span style="color:var(--ocean);">➜</span>
        <span class="chip">NotebookLM 筆記</span> <span style="color:var(--ocean);">➜</span>
        <span class="chip">轉為來源</span> <span style="color:var(--ocean);">➜</span>
        <span class="chip">Deep Research</span> <span style="color:var(--ocean);">➜</span>
        <span class="chip">研究報告</span> <span style="color:var(--ocean);">➜</span>
        <span class="chip">簡報/圖表</span>
      </div>
    </article>
  </section>

  <section class="feature-grid">
    <article class="card showcase-card">
      <p class="eyebrow">成果 1</p>
      <h2>深度研究報告</h2>
      <p>透過多方來源交叉比對，產出具備事實查核的旅遊景點歷史與交通分析。</p>
    </article>
    <article class="card showcase-card">
      <p class="eyebrow">成果 2</p>
      <h2>行程規劃簡報</h2>
      <p>將研究報告整理成每日行程大綱，適合與旅伴開會討論時直接投影。</p>
    </article>
    <article class="card showcase-card">
      <p class="eyebrow">成果 3</p>
      <h2>行前準備資訊圖表</h2>
      <p>行李清單、天氣提醒、緊急聯絡方式，一目了然的行前懶人包。</p>
    </article>
  </section>

  <section id="notebook-prompts" class="section-heading">
    <p class="eyebrow">📂 研究資料櫃</p>
    <h2>研究、行程、簡報、資訊圖表一次備好</h2>
  </section>
  <div class="prompt-grid">
    {notebookContent.prompts.map((item) => <PromptCard title={item.title} platform="NotebookLM" prompt={item.prompts.chatgpt} />)}
  </div>

  <!-- NotebookLM & 視覺生成工作室 (Studio) -->
  <section class="studio-section" id="studio-workspace">
    <div class="section-heading">
      <p class="eyebrow">🎨 實作工作坊</p>
      <h2>NotebookLM 視覺與簡報生成工作室</h2>
      <p style="color: var(--ink-soft); max-width: 800px; margin: 8px auto 0; font-size: 1.05rem; line-height: 1.6;">
        使用 NotebookLM 整理完行程研究後，可以直接在這裡複製簡報、資訊圖表或語音摘要的提示詞，套用至 NotebookLM、ChatGPT 與 Gemini！
      </p>
    </div>

    <!-- Studio Tabs -->
    <div class="studio-tabs">
      <button class="studio-tab active" data-tab="tab-ppt">📊 簡報生成提示詞</button>
      <button class="studio-tab" data-tab="tab-infographic">🗺️ 資訊圖表生成提示詞</button>
      <button class="studio-tab" data-tab="tab-podcast">🎙️ 語音摘要生成提示詞</button>
    </div>

    <div class="studio-panels">
      <!-- Panel A: PPT -->
      <div class="studio-panel active" id="tab-ppt">
        <h3 style="font-size: 1.25rem; font-weight: bold; color: var(--night); margin-bottom: 12px; text-align: center;">📊 Step 1：選擇簡報對象與情境</h3>
        <p style="color: var(--ink-soft); font-size: 0.95rem; text-align: center; margin-bottom: 24px;">我們已為您預設與情境最適配的視覺風格，請點選以下卡片以取得 YAML 簡報提示詞</p>
        
        <div class="studio-grid">
          {Object.entries(pptScenarios).map(([key, item]) => (
            <div class={`studio-card ${key === 'family' ? 'active' : ''}`} data-ppt-key={key}>
              <span class="emoji">{item.emoji}</span>
              <span class="title">{item.title}</span>
              <span class="desc" style="margin-top: 4px; font-weight: bold; color: var(--page-accent, var(--sunset));">{item.visualStyle}</span>
            </div>
          ))}
        </div>

        <div class="studio-prompt-box">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <strong style="color: var(--night); font-size: 1.05rem;">📊 20 頁 YAML 簡報指令</strong>
            <span style="font-size: 0.8rem; color: var(--ink-soft);">可貼到 NotebookLM 對話區</span>
          </div>
          <textarea id="ppt-prompt" class="studio-textarea" readonly>{pptScenarios.family.prompt}</textarea>
          
          <div class="studio-actions">
            <button type="button" class="btn" id="copy-ppt-btn" style="background: var(--page-accent, var(--sunset)); color: white; border: none;">📋 複製簡報指令</button>
            <a href={siteConfig.externalLinks.notebookLmUrl} target="_blank" rel="noopener noreferrer" class="btn" style="background: #2c2c2c; color: white; border: none; text-decoration: none;">🚀 去 NotebookLM 生成</a>
          </div>
          <p style="font-size: 0.8rem; color: var(--ink-soft); margin-top: 12px; text-align: center; line-height: 1.4;">
            💡 貼到 NotebookLM 的對話區，再將產出的 YAML 貼到簡報功能的「說明要建立的簡報」對話框中。
          </p>
        </div>
      </div>

      <!-- Panel B: Infographic -->
      <div class="studio-panel" id="tab-infographic">
        <h3 style="font-size: 1.25rem; font-weight: bold; color: var(--night); margin-bottom: 12px; text-align: center;">🎨 選擇風格化資訊圖表視覺</h3>
        <p style="color: var(--ink-soft); font-size: 0.95rem; text-align: center; margin-bottom: 24px;">生成圖表提示詞，協助您在 Gemini 中繪製出精美路線與導覽圖</p>

        <div class="studio-grid">
          {Object.entries(infographicStyles).map(([key, item]) => (
            <div class={`studio-card ${key === 'watercolor' ? 'active' : ''}`} data-infographic-key={key}>
              <span class="emoji">{item.emoji}</span>
              <span class="title">{item.name}</span>
              <span class="desc" style="margin-top: 4px;">{item.target}</span>
            </div>
          ))}
        </div>

        <div class="studio-prompt-box">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <strong style="color: var(--night); font-size: 1.05rem;">🗺️ 資訊圖表生成提示詞</strong>
            <span style="font-size: 0.8rem; color: var(--ink-soft);">可貼到 Gemini 繪圖工具</span>
          </div>
          <textarea id="infographic-prompt" class="studio-textarea" readonly></textarea>
          
          <div class="studio-actions">
            <button type="button" class="btn" id="copy-infographic-btn" style="background: var(--page-accent, var(--sunset)); color: white; border: none;">📋 複製圖表提示詞</button>
            <a href={siteConfig.externalLinks.geminiUrl} target="_blank" rel="noopener noreferrer" class="btn gemini-btn-brand" style="text-decoration: none;">🚀 開啟 Gemini 生成圖表</a>
          </div>
        </div>
      </div>

      <!-- Panel C: Podcast -->
      <div class="studio-panel" id="tab-podcast">
        <h3 style="font-size: 1.25rem; font-weight: bold; color: var(--night); margin-bottom: 12px; text-align: center;">🎙️ Step 1：選擇語音對象與情境</h3>
        <p style="color: var(--ink-soft); font-size: 0.95rem; text-align: center; margin-bottom: 24px;">我們已為您調配對應的情境與口吻，請點選以下卡片以取得 NotebookLM 語音自訂指令</p>

        <div class="studio-grid">
          {Object.entries(podcastScenarios).map(([key, item]) => (
            <div class={`studio-card ${key === 'family' ? 'active' : ''}`} data-podcast-key={key}>
              <span class="emoji">{item.emoji}</span>
              <span class="title">{item.title}</span>
              <span class="desc" style="margin-top: 4px; font-weight: bold; color: var(--page-accent, var(--sunset));">{item.focusRole}</span>
            </div>
          ))}
        </div>

        <div class="studio-prompt-box">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <strong style="color: var(--night); font-size: 1.05rem;">🎧 語音摘要 (Audio Overview) 自訂指令</strong>
            <span style="font-size: 0.8rem; color: var(--ink-soft);">貼到 NotebookLM 語音自訂對話框中再生成</span>
          </div>
          <textarea id="podcast-prompt" class="studio-textarea" readonly>{podcastScenarios.family.prompt}</textarea>
          
          <div class="studio-actions">
            <button type="button" class="btn" id="copy-podcast-btn" style="background: var(--page-accent, var(--sunset)); color: white; border: none;">📋 複製語音自訂指令</button>
            <a href={siteConfig.externalLinks.notebookLmUrl} target="_blank" rel="noopener noreferrer" class="btn" style="background: #2c2c2c; color: white; border: none; text-decoration: none;">🚀 去 NotebookLM 生成</a>
          </div>
          <p style="font-size: 0.8rem; color: var(--ink-soft); margin-top: 12px; text-align: center; line-height: 1.4;">
            💡 點擊語音摘要 (Audio Overview) 旁的筆「自訂 (Customize)」，將此指令貼入「在本集中，AI 主持人應著重哪些部分？」框中，然後點擊生成。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="asset-grid" style="margin-top: 32px;">
    <ImageCard src="/images/notebooklm/notebooklm-sources-01.webp" alt="NotebookLM 來源資料整理示意，包含文件、卡片與地圖素材" title="把需求變成來源" text="先讓 NotebookLM 擁有你的旅遊背景，再請它做深入研究。" />
    <ImageCard src="/images/notebooklm/research-output-01.webp" alt="NotebookLM 旅遊研究報告成果，包含比較卡、地圖與檢查清單" title="研究報告成果" text="資訊查證、景點比較與交通規劃可以集中在同一份報告裡。" />
    <ImageCard src="/images/notebooklm/presentation-output-01.webp" alt="旅遊研究延伸成簡報與資訊圖表的成果展示" title="簡報與圖表延伸" text="課後可再把研究內容改成簡報、懶人包或同行討論資料。" />
  </section>

  <script is:inline define:vars={{ pptScenarios, infographicStyles, podcastScenarios }}>
    // 1. Studio Tab 點擊切換
    const tabs = document.querySelectorAll('.studio-tab');
    const panels = document.querySelectorAll('.studio-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        tab.classList.add('active');
        const targetId = tab.getAttribute('data-tab');
        document.getElementById(targetId).classList.add('active');
      });
    });

    // 2. Scenario (Panel A) 切換
    const pptCards = document.querySelectorAll('[data-ppt-key]');
    const pptTextarea = document.getElementById('ppt-prompt');
    pptCards.forEach(card => {
      card.addEventListener('click', () => {
        pptCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        const key = card.getAttribute('data-ppt-key');
        if (pptScenarios[key]) {
          pptTextarea.value = pptScenarios[key].prompt;
        }
      });
    });

    // 3. Infographic Style (Panel B) 切換
    const infographicCards = document.querySelectorAll('[data-infographic-key]');
    const infographicTextarea = document.getElementById('infographic-prompt');
    
    function updateInfographicPrompt(key) {
      const s = infographicStyles[key];
      if (s) {
        infographicTextarea.value = `# 角色與目標
你是一位專業的插畫家。請將來源的行程轉化為一幅資訊圖表地圖。

# 視覺風格要求 (關鍵)
- 藝術風格: ${s.prompt}
- 版面與動線: 一條蜿蜒的路徑，從上而下。使用虛線連接事件。
- 貼圖與文字標註: 使用繁體中文標註地名與時間。

# 內容元素
1. 時間: 清晰的時鐘圖示。
2. 地點/活動: 具體的交通工具、建築外觀。
3. 食物: 美味的食物插畫。`;
      }
    }

    infographicCards.forEach(card => {
      card.addEventListener('click', () => {
        infographicCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        const key = card.getAttribute('data-infographic-key');
        updateInfographicPrompt(key);
      });
    });
    
    // 預載 Infographic Prompt
    updateInfographicPrompt('watercolor');

    // 4. Podcast Scenario (Panel C) 切換
    const podcastCards = document.querySelectorAll('[data-podcast-key]');
    const podcastTextarea = document.getElementById('podcast-prompt');
    podcastCards.forEach(card => {
      card.addEventListener('click', () => {
        podcastCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        const key = card.getAttribute('data-podcast-key');
        if (podcastScenarios[key]) {
          podcastTextarea.value = podcastScenarios[key].prompt;
        }
      });
    });

    // 5. Copy Buttons Utility
    function handleCopy(btnId, textareaId) {
      const btn = document.getElementById(btnId);
      const textarea = document.getElementById(textareaId);
      if (!btn || !textarea) return;

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(textarea.value);
          const originalText = btn.textContent;
          btn.textContent = '✅ 複製成功！';
          btn.style.background = '#10b981';
          
          showToast('複製成功，請貼到 AI 工具中使用！');

          setTimeout(() => {
            btn.textContent = originalText;
            btn.style.background = '';
          }, 2000);
        } catch (err) {
          alert('複製失敗，請手動複製！');
        }
      });
    }

    handleCopy('copy-ppt-btn', 'ppt-prompt');
    handleCopy('copy-infographic-btn', 'infographic-prompt');
    handleCopy('copy-podcast-btn', 'podcast-prompt');

    // Helper function for showing toast
    function showToast(msg) {
      let toast = document.querySelector('.copy-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.className = 'copy-toast';
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }
  </script>

  <style>
    /* Studio Section Styles */
    .studio-section {
      margin: 48px 0 64px;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 40px;
      box-shadow: var(--shadow-soft);
    }
    
    .studio-tabs {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin: 32px 0 36px;
      border-bottom: 2px solid var(--line);
      padding-bottom: 0;
    }
    
    .studio-tab {
      padding: 12px 28px;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--ink-soft);
      background: transparent;
      border: none;
      border-bottom: 3px solid transparent;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-bottom: -2px;
    }
    
    .studio-tab:hover {
      color: var(--page-accent, var(--sunset));
    }
    
    .studio-tab.active {
      color: var(--page-accent, var(--sunset));
      border-bottom-color: var(--page-accent, var(--sunset));
    }
    
    .studio-panel {
      display: none;
      animation: fadeIn 0.4s ease forwards;
    }
    
    .studio-panel.active {
      display: block;
    }

    /* Grid Layouts for options */
    .studio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }
    
    .studio-card {
      background: #ffffff;
      border: 2px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 24px 20px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: var(--shadow-soft);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    
    .studio-card:hover {
      border-color: var(--page-accent, var(--sunset));
      transform: translateY(-3px);
      box-shadow: var(--shadow-medium);
      background: #fffaf9;
    }
    
    .studio-card.active {
      border-color: var(--page-accent, var(--sunset));
      background: #fff8f6;
      box-shadow: 0 4px 12px rgba(255, 122, 92, 0.15);
    }
    
    .studio-card .emoji {
      font-size: 2.2rem;
    }
    
    .studio-card .title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--night);
    }
    
    .studio-card .desc {
      font-size: 0.85rem;
      color: var(--ink-soft);
      line-height: 1.4;
    }

    /* Textarea block */
    .studio-prompt-box {
      background: #fafafa;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 24px;
      margin: 28px 0 16px;
    }
    
    .studio-textarea {
      width: 100%;
      min-height: 280px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      padding: 16px;
      font-family: monospace;
      font-size: 0.9rem;
      line-height: 1.6;
      background: #ffffff;
      resize: vertical;
      box-sizing: border-box;
      color: #334155;
    }
    
    .studio-textarea:focus {
      outline: none;
      border-color: var(--page-accent, var(--sunset));
      box-shadow: 0 0 0 3px rgba(255, 122, 92, 0.1);
    }
    
    .studio-actions {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .gemini-btn-brand {
      background: linear-gradient(135deg, #1a73e8 0%, #4f46e5 100%) !important;
      color: #ffffff !important;
      font-weight: 700;
      border: none !important;
      box-shadow: 0 4px 12px rgba(26, 115, 232, 0.2);
    }
    
    .gemini-btn-brand:hover {
      filter: brightness(1.1);
      box-shadow: 0 6px 16px rgba(26, 115, 232, 0.35);
      transform: translateY(-2px);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 992px) {
      .studio-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .studio-section {
        padding: 24px 20px;
      }
      .studio-tabs {
        flex-direction: column;
        align-items: stretch;
        border-bottom: none;
      }
      .studio-tab {
        border-bottom: none;
        border-left: 3px solid transparent;
        padding: 10px 16px;
        text-align: left;
        margin-bottom: 0;
      }
      .studio-tab.active {
        border-left-color: var(--page-accent, var(--sunset));
        background: #fff8f6;
      }
      .studio-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }
      .studio-card {
        padding: 16px 12px;
      }
      .studio-card .emoji {
        font-size: 1.8rem;
      }
      .studio-card .title {
        font-size: 0.95rem;
